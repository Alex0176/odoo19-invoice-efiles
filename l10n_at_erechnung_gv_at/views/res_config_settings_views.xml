<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_at_erechnung_gv_at</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='peppol']" position="after">
                <block title="e-Rechnung.gv.at" id="l10n_at_erb">
                    <setting string="Unternehmensserviceportal (USP)" help="Technical webservice user, created in USP administration with 'e-Rechnung.gv.at Webservice' enabled.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="l10n_at_erb_usp_username" class="col-lg-3 o_light_label" string="Benutzername" />
                                <field name="l10n_at_erb_usp_username" />
                            </div>
                            <div class="row">
                                <label for="l10n_at_erb_usp_password" class="col-lg-3 o_light_label" string="Passwort" />
                                <field name="l10n_at_erb_usp_password" password="True" />
                            </div>
                            <div class="row">
                                <label for="l10n_at_erb_environment" class="col-lg-3 o_light_label" string="Umgebung" />
                                <field name="l10n_at_erb_environment" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
